    <artifactId>example-domain</artifactId>
    <name>example-domain</name>

    <dependencies>
        <!-- Consumer POM (flattened): removed, test scope is not transitive -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>